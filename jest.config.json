{
	"clearMocks": true,
	"collectCoverage": true,
	"collectCoverageFrom": [
		"**/*.js",
		"!**/test/**"
	],
	"coveragePathIgnorePatterns": [
		"/node_modules/"
	],
	"coverageThreshold": {
		"./packages/**/*.js": {
			"branches": 80,
			"functions": 80,
			"lines": 80,
			"statements": 80
		}
	},
	"testEnvironment": "node"
}